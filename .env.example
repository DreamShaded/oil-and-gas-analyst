#  
# Универсальная конфигурация LLM-провайдера (OpenAI-совместимый).
# Можно подменить на любой совместимый endpoint: OpenAI, OpenRouter,
# Together, локальный vLLM/Ollama, корпоративный шлюз и т.п.
# 
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_TOKEN=changeme
# LLM_MODEL=gpt-5.1
# LLM_FAST_MODEL=gpt-4o-mini
# LLM_TIMEOUT_S=60

# # Embeddings обычно тоже через OpenAI
# EMBEDDINGS_API_URL=https://api.openai.com/v1
# EMBEDDINGS_API_TOKEN=changeme
# EMBEDDINGS_MODEL=text-embedding-3-large

# Anthropic Claude как LLM (Embeddings оставляем на Ollama локально)
# LLM_API_URL=https://api.anthropic.com
# LLM_API_TOKEN=sk-ant-...
# LLM_MODEL=claude-opus-4-7
# LLM_FAST_MODEL=claude-haiku-4-5-20251001
# LLM_TIMEOUT_S=120

# Тестируем локально, когда будет готово - перейдём на платный API
LLM_API_URL=http://host.docker.internal:11434/v1
LLM_API_TOKEN=ollama
LLM_MODEL=qwen3:8b
LLM_FAST_MODEL=qwen3:8b
LLM_TIMEOUT_S=180

# Embeddings — всегда OpenAI-совместимый endpoint (Ollama / OpenAI / vLLM).
# Anthropic embeddings отдельно не реализован 
EMBEDDINGS_API_URL=http://host.docker.internal:11434/v1
EMBEDDINGS_API_TOKEN=ollama
EMBEDDINGS_MODEL=nomic-embed-text

# 
# Векторное хранилище (Qdrant)
# 
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
RAG_COLLECTION=oil_gas_reports

# 
# RAG параметры
# 
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=8
RAG_MIN_SCORE=0.30

# 
# Внешние API
#
TAVILY_API_KEY=
EIA_API_KEY=

# 
# Приложение
# 
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=7860
DATA_DIR=./data