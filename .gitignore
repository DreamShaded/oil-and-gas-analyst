# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.so
.eggs/

# Virtual environments
.venv/
venv/
env/

# uv
# uv.lock is intentionally kept (reproducible builds)
.uv/

# Linters / type checkers
.ruff_cache/
.mypy_cache/

# Tests
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.lcov

# Environment — NEVER commit secrets
.env
.env.*
!.env.example

# Data — PDFs are large and private
data/reports/*.pdf
data/reports/*.PDF

# Docker volumes (local dev)
.data/
qdrant_data/
postgres_data/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Alembic generated bytecode
src/persistence/alembic/__pycache__/
src/persistence/alembic/versions/__pycache__/

# Misc
*.log
*.tmp
data/runtime_config.json

# Скрипты выгрузки/парсинга — НЕ коммитим (внешние утилиты)
scripts/*
!scripts/.gitkeep
!scripts/README.md
